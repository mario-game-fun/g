(async () => {
  const fileUrl = 'https://classic.mariogames.be/nes/2/super-mario-bros.nes';
  const fileName = 'super-mario-bros.nes';

  try {
    console.log('Đang bắt đầu tải file...');
    const response = await fetch(fileUrl);
    
    if (!response.ok) throw new Error('Không thể kết nối đến máy chủ.');
    
    const blob = await response.blob();
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    
    a.style.display = 'none';
    a.href = url;
    a.download = fileName;
    
    document.body.appendChild(a);
    a.click();
    
    // Dọn dẹp bộ nhớ
    window.URL.revokeObjectURL(url);
    document.body.removeChild(a);
    
    console.log('Tải xuống thành công: ' + fileName);
  } catch (error) {
    console.error('Lỗi khi tải file:', error.message);
    console.log('Lưu ý: Nếu bị lỗi CORS, bạn cần mở trang web "classic.mariogames.be" trước rồi mới dán code này vào Console.');
  }
})();